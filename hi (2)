@charset "utf-8";

h2 { color: black; background-color: pink; background-image: url("/nimesh.jpg"); background-size: cover; box-shadow: rgb(0, 0, 0) 0px 0px 5px; text-decoration: underline wavy blue; }

#one { background: linear-gradient(45deg, rgb(255, 107, 107), rgb(78, 205, 196), rgb(69, 183, 209), rgb(150, 206, 180)) gold; border-color: black; text-align: center; border-radius: 40px; color: black; border-style: solid; border-width: 3px; }

body { background-color: rgb(142, 120, 83); }

#ten { color: black; border-style: dotted; background-color: rgb(29, 255, 166); border-color: blue; }

h4 { }

article { text-align: right; }

button { width: 50%; padding: 14px; font-size: 16px; background: -webkit-linear-gradient(left, rgb(0, 240, 255), rgb(0, 251, 187)); border-radius: 8px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: white; font-weight: bold; cursor: pointer; transition: transform 0.2s, box-shadow 0.3s; box-shadow: rgba(0, 240, 255, 0.4) 0px 0px 10px; }

#eight { text-decoration: underline red; border-style: solid; background: linear-gradient(45deg, rgb(111, 237, 255), rgb(65, 221, 9)); }

input { text-transform: uppercase; }

a { background-color: gray; }

#two { transition: 150ms cubic-bezier(0.4, 0, 0.2, 1); border-radius: 40px; }

#year { background-color: white; width: 130px; }

hr { height: 5px; }

option { background-color: rgba(203, 113, 27, 0.99); }

#zero { color: rgba(255, 251, 0, 0.99); border: 5px solid red; background-color: rgba(0, 56, 255, 0.99); }

#nine { border: 3px solid red; box-sizing: content-box; }

.img { padding-left: 150px; padding-right: 150px; border-style: double; border-color: black; background-color: rgb(255, 5, 5); }

.beautiful-btn { padding: 15px 30px; font-size: 18px; font-weight: bold; color: white; background: linear-gradient(45deg, rgb(22, 66, 201), rgb(78, 205, 196), rgb(201, 9, 221), rgb(65, 221, 9), rgb(9, 175, 221), rgb(214, 221, 9), rgba(50, 16, 62, 0.72)) 0% 0% / 400% 400%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 70px; cursor: pointer; box-shadow: rgba(0, 0, 0, 0.3) 0px 8px 32px; transition: 0.3s; animation: 3s ease 0s infinite normal none running gradientShift; text-transform: uppercase; letter-spacing: 1px; }

.beautiful-btn:hover { transform: translateY(-5px); box-shadow: rgba(0, 0, 0, 0.4) 0px 15px 40px; background-position: right center; }

.beautiful-btn:active { transform: translateY(-2px); }

@keyframes gradientShift { 
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
